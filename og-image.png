<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#0B3A67"/>
      <stop offset="50%" stop-color="#123B82"/>
      <stop offset="100%" stop-color="#0B3A67"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Decorative wave -->
  <path d="M0 420 C 150 360, 300 360, 450 420 S 750 480, 900 420 S 1050 360, 1200 400 L 1200 630 L 0 630 Z" fill="#FF7F0F" opacity="0.85"/>
  <path d="M0 470 C 160 510, 320 510, 480 470 S 800 430, 960 470 S 1120 510, 1200 500 L 1200 630 L 0 630 Z" fill="#FF9B3D" opacity="0.35"/>

  <!-- Badge / emblem -->
  <g transform="translate(120,160)" filter="url(#shadow)">
    <circle cx="0" cy="0" r="64" fill="#0B3A67" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
    <path d="M-44 8 C -24 0, -8 -28, 16 -28 C 40 -28, 56 0, 76 8" fill="none" stroke="#FF7F0F" stroke-width="6" stroke-linecap="round"/>
  </g>

  <!-- Title -->
  <text x="120" y="180" fill="#FFFFFF" font-family="Segoe UI, Roboto, Arial, sans-serif" font-size="56" font-weight="800">Audacity for Windows</text>
  <text x="120" y="240" fill="#DCE7F6" font-family="Segoe UI, Roboto, Arial, sans-serif" font-size="28">Free, Safe 64‑bit Download • Windows 10/11</text>

  <!-- Feature chips -->
  <g font-family="Segoe UI, Roboto, Arial, sans-serif" font-size="22" fill="#0B3A67">
    <rect x="120" y="280" rx="12" ry="12" width="320" height="50" fill="#FFFFFF" opacity="0.95"/>
    <text x="140" y="314">WASAPI loopback</text>
    <rect x="460" y="280" rx="12" ry="12" width="270" height="50" fill="#FFFFFF" opacity="0.95"/>
    <text x="480" y="314">VST3/LV2 effects</text>
    <rect x="760" y="280" rx="12" ry="12" width="260" height="50" fill="#FFFFFF" opacity="0.95"/>
    <text x="780" y="314">Export MP3/WAV</text>
  </g>

  <!-- CTA button style banner -->
  <g transform="translate(120,380)" filter="url(#shadow)">
    <rect x="0" y="0" rx="16" ry="16" width="600" height="90" fill="#FF7F0F"/>
    <text x="30" y="58" fill="#111111" font-family="Segoe UI, Roboto, Arial, sans-serif" font-size="34" font-weight="800">Download for Windows (64‑bit)</text>
  </g>

  <!-- Windows icon -->
  <g transform="translate(1060,150) scale(1.6)" opacity="0.9">
    <path d="M0 0 L70 -12 V36 H0 Z M0 46 L70 58 V100 H0 Z M80 -14 L140 -24 V36 H80 Z M140 46 V110 L80 100 V46 Z" fill="#FFFFFF"/>
  </g>

  <!-- Footer note -->
  <text x="120" y="580" fill="#F3F8FF" font-family="Segoe UI, Roboto, Arial, sans-serif" font-size="18" opacity="0.9">Unofficial guide • Not affiliated with the Audacity Team</text>
</svg>
